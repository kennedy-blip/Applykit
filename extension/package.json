{
  "name": "applykit-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ApplyKit Multi-Browser AI Job & Freelance Assistant for Chrome, Edge, Brave, Opera & Firefox",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "build:edge": "wxt build --browser edge",
    "build:firefox": "wxt build --browser firefox --mv3",
    "build:opera": "wxt build --browser opera",
    "zip:all": "wxt zip --browser chrome && wxt zip --browser edge && wxt zip --browser firefox --mv3"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/webextension-polyfill": "^0.12.3",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.7.3",
    "wxt": "^0.19.29"
  }
}
